WITH first_year AS (
    SELECT
        product_id,
        MIN(year) AS first_year
    FROM Sales s
    GROUP BY product_id
    ORDER BY product_id
)
SELECT 
    s.product_id,
    f.first_year,
    s.quantity,
    s.price
FROM Sales s
JOIN first_year f ON s.product_id = f.product_id
    AND f.first_year = s.year